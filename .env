# ============================================================
#  ESSL Attendance System — Environment Configuration
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=essl_v2
DB_USER=postgres
DB_PASS=0.00

# ── Device 1 (IN Device) ────────────────────────────────────
DEVICE_1_IP=192.168.1.201
DEVICE_1_PORT=4370
DEVICE_1_TIMEOUT=30

# ── Device 2 (OUT Device) ───────────────────────────────────
DEVICE_2_IP=192.168.1.4
DEVICE_2_PORT=4370
DEVICE_2_TIMEOUT=30

# ── Legacy (maps to Device 1) ───────────────────────────────
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370
DEVICE_TIMEOUT=30

# ── Application ─────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
SYNC_INTERVAL_MINUTES=5

# ── CRITICAL: Logical Day Boundary ──────────────────────────
# Set this AFTER your latest shift end time.
# Hospital night shifts end at ~07:00 → use 08:00
# If set too early, night-shift OUT punches go to the wrong
# day and every night worker shows INCOMPLETE every day.
DAY_START_TIME=08:00

# ── Attendance Rules ─────────────────────────────────────────
PRESENT_HOURS=9.0
HALF_DAY_HOURS=4.5