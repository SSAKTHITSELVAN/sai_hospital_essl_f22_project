# ============================================================
#  ESSL Attendance System — Environment Configuration
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=essl
DB_USER=postgres
DB_PASS=your_password_here          # IMPORTANT: change this

# ── Device ──────────────────────────────────────────────────
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370
DEVICE_TIMEOUT=30

# ── Application ─────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
SYNC_INTERVAL_MINUTES=5

# ── Attendance Rules ─────────────────────────────────────────
# All thresholds are in HOURS (decimals allowed)
PRESENT_HOURS=9.0        # >= this → Present
HALF_DAY_HOURS=4.5       # >= this but < PRESENT_HOURS → Half Day
# < HALF_DAY_HOURS → Absent / Incomplete (no punches vs punches found)

# Overtime threshold: hours worked beyond PRESENT_HOURS count as OT
# e.g. 10.5h worked → 1.5h OT

# Break gap: minimum gap (minutes) between two punch-pairs to be treated
# as a separate session rather than noise.  Set to 30 minutes.
MIN_BREAK_GAP_MINUTES=30

# Grace period for "no checkout" inference:
# If only IN punches exist and the gap between first and last is
# >= this value (minutes) the last punch is treated as check-out.
INFERRED_CHECKOUT_GAP_MINUTES=60