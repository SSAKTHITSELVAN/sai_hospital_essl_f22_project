# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=essl
DB_USER=postgres
DB_PASS=your_password_here  # ← IMPORTANT: Change this!

# Device Configuration
DEVICE_IP=192.168.1.50      # ← Your fingerprint device IP
DEVICE_PORT=4370
DEVICE_TIMEOUT=30

# Application Configuration
APP_HOST=0.0.0.0            # 0.0.0.0 allows network access
APP_PORT=8000
SYNC_INTERVAL_MINUTES=5

# Shift Timings (24-hour format)
SHIFT_A_START=07:00
SHIFT_A_END=15:00
SHIFT_B_START=15:00
SHIFT_B_END=23:00
SHIFT_C_START=23:00
SHIFT_C_END=07:00
SHIFT_G_START=09:00
SHIFT_G_END=17:00

# Grace Periods (minutes)
LATE_GRACE_MINUTES=15
EARLY_LEAVE_GRACE_MINUTES=15