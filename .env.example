
# ================================================================
#  ESSL Attendance System — Environment Configuration
# ================================================================

# ── Database ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=essl
DB_USER=postgres
DB_PASS=your_password_here          # IMPORTANT: change this

# ── Device ───────────────────────────────────────────────────────
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370
DEVICE_TIMEOUT=30

# ── Application ──────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
SYNC_INTERVAL_MINUTES=5

# ── Day Boundary ─────────────────────────────────────────────────
# A "work day" starts at this time and ends 24 hours later.
# e.g. DAY_START_TIME=04:00 means the day runs 04:00 → 03:59 next day.
# This lets night-shift employees whose work crosses midnight still
# be counted on the correct calendar date.
# Format: HH:MM  (24-hour)
DAY_START_TIME=04:00

# ── Attendance Status Thresholds (hours) ─────────────────────────
PRESENT_HOURS=9.0      # >= this            → Present  (or Present+OT)
HALF_DAY_HOURS=4.5     # >= this < PRESENT  → Half Day
                       # > 0    < HALF_DAY  → Incomplete
                       # 0 punches          → Absent